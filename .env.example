# Secret used to sign proof records (HMAC-SHA256).
# Generate with: openssl rand -hex 32
PROOFDROP_ANCHOR_SECRET=replace-with-a-long-random-secret

# Owner dashboard password (8+ chars) and session signing secret (16+ chars).
PROOFDROP_ADMIN_PASSWORD=replace-with-a-strong-password
PROOFDROP_ADMIN_SECRET=replace-with-a-long-random-secret

# Optional durable storage on serverless hosts (Vercel KV / Upstash Redis REST).
# KV_REST_API_URL=https://your-redis.upstash.io
# KV_REST_API_TOKEN=your-token
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
